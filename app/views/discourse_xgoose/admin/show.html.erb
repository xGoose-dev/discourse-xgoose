<!doctype html><html lang="<%= I18n.locale %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="<%= form_authenticity_token %>"><title>xGoose <%= @session.id %></title><style>body{font:16px/1.5 system-ui;margin:2rem auto;padding:0 1rem;max-width:1000px}pre{white-space:pre-wrap;overflow-wrap:anywhere;padding:1rem;background:#f4f4f8}a{color:#5145cd}details{margin:1rem 0}button{font:inherit;padding:.5rem}</style></head><body>
<a href="<%= Discourse.base_path %>/admin/plugins/xgoose"><%= I18n.t("xgoose.admin.back") %></a><h1>xGoose #<%= @session.id %></h1>
<p><%= I18n.t("xgoose.admin.user") %>: <%= @session.user_id %> · <%= @session.created_at.iso8601 %></p>
<p><strong><%= I18n.t(@complete ? "xgoose.admin.complete" : "xgoose.admin.incomplete") %></strong></p>
<p><%= I18n.t("xgoose.admin.client_note") %></p>
<a href="<%= request.path %>.json">JSON</a> · <a href="<%= request.path %>.txt"><%= I18n.t("xgoose.admin.export") %></a>
<% @requests.each do |r| %><details open><summary><%= r.request_id %> — <%= r.status %> — <%= r.charged_tokens %> tokens (<%= r.estimated ? "estimated" : "reported" %>) — <%= r.duration_ms %> ms</summary><h2><%= I18n.t("xgoose.admin.input") %></h2><pre><%= JSON.pretty_generate(r.messages) %></pre><h2><%= I18n.t("xgoose.admin.output") %></h2><pre><%= JSON.pretty_generate(r.response_message) %></pre><p><%= r.error_code %></p></details><% end %>
<h2><%= I18n.t("xgoose.admin.client_events") %></h2><% @events.each do |event| %><details><summary><%= event.sequence %> — <%= event.kind %> — <%= event.created_at.iso8601 %></summary><pre><%= JSON.pretty_generate(event.payload) %></pre></details><% end %>
<button id="delete"><%= I18n.t("xgoose.admin.delete") %></button><script nonce="<%= content_security_policy_nonce %>">document.getElementById("delete").addEventListener("click",async()=>{if(!confirm(<%= raw(I18n.t("xgoose.admin.confirm_delete").to_json) %>))return;const r=await fetch(location.pathname,{method:"DELETE",headers:{"X-CSRF-Token":document.querySelector('meta[name="csrf-token"]').content,"Accept":"application/json"}});if(r.ok)location.href=<%= raw((Discourse.base_path + "/admin/plugins/xgoose").to_json) %>;else alert(<%= raw(I18n.t("xgoose.admin.delete_failed").to_json) %>);});</script>
</body></html>
