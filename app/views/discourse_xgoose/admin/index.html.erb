<!doctype html><html lang="<%= I18n.locale %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>xGoose</title><%= render "discourse_xgoose/admin/styles" %></head><body>
<a href="<%= Discourse.base_path %>/admin/plugins"><%= I18n.t("xgoose.admin.back") %></a>
<h1><%= I18n.t("xgoose.admin.title") %></h1><p><%= I18n.t("xgoose.admin.client_note") %></p>
<form method="get"><label><%= I18n.t("xgoose.admin.user") %> <input type="number" name="user_id" value="<%= params[:user_id] %>"></label><label><%= I18n.t("xgoose.admin.status") %> <select name="status"><option value=""></option><% %w[completed failed interrupted reserved].each do |status| %><option <%= "selected" if params[:status] == status %>><%= status %></option><% end %></select></label><label><%= I18n.t("xgoose.admin.after") %><input type="date" name="after" value="<%= params[:after] %>"></label><label><%= I18n.t("xgoose.admin.before") %><input type="date" name="before" value="<%= params[:before] %>"></label><button><%= I18n.t("xgoose.admin.filter") %></button></form>
<table><thead><tr><th>ID</th><th><%= I18n.t("xgoose.admin.user") %></th><th><%= I18n.t("xgoose.admin.created") %></th><th><%= I18n.t("xgoose.admin.cost") %></th></tr></thead><tbody><% @sessions.each do |session| %><tr><td><a href="<%= Discourse.base_path %>/admin/plugins/xgoose/<%= session.id %>"><%= session.id %></a></td><td><%= session.user&.username || session.user_id %></td><td><%= session.created_at.iso8601 %></td><td>$<%= format("%.6f", session.requests.sum(&:charged_microusd) / 1_000_000.0) %></td></tr><% end %></tbody></table>
<a href="?<%= params.permit(:user_id, :status, :after, :before).to_h.merge(page: params[:page].to_i + 1).to_query %>"><%= I18n.t("xgoose.admin.next") %></a>
</body></html>
