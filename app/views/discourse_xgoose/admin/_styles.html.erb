<style>
:root{color-scheme:light dark;--bg:#faf9fd;--surface:#fff;--ink:#222133;--muted:#727083;--border:#e8e5ef;--accent:#7952c5}*{box-sizing:border-box}body{font:14px/1.65 system-ui,sans-serif;margin:48px auto;padding:0 24px 60px;max-width:1100px;color:var(--ink);background:var(--bg)}h1{font-size:32px;letter-spacing:-1px;margin:20px 0 12px}h1:before{content:'✦';display:inline-grid;place-items:center;background:linear-gradient(135deg,#6366f1,#a855f7,#ec4899);color:white;width:40px;height:40px;border-radius:12px;font-size:30px;margin-right:12px;vertical-align:middle}h2{font-size:15px}a{color:var(--accent);text-underline-offset:3px}p{color:var(--muted);max-width:850px}table{border-collapse:collapse;width:100%;margin:24px 0;background:var(--surface);border:1px solid var(--border);border-radius:12px}td,th{text-align:left;padding:14px 16px;border-bottom:1px solid var(--border)}th{font-size:11px;letter-spacing:.6px;text-transform:uppercase;color:var(--muted)}form{display:flex;gap:12px;align-items:end;flex-wrap:wrap;padding:20px;background:var(--surface);border:1px solid var(--border);border-radius:14px;margin-top:24px}label{font-size:11px;color:var(--muted);display:grid;gap:4px}input,select,button{font:inherit;padding:8px 12px;max-width:100%;border:1px solid var(--border);background:var(--surface);color:var(--ink);border-radius:8px}button{cursor:pointer;background:var(--accent);color:#fff;border:0}details{background:var(--surface);padding:16px 20px;border:1px solid var(--border);border-radius:12px;margin:14px 0}summary{cursor:pointer;overflow-wrap:anywhere;font-size:12px;font-weight:600}pre{white-space:pre-wrap;overflow-wrap:anywhere;padding:14px;background:var(--bg);border-radius:8px;font-size:11px;max-height:600px;overflow:auto}#delete{margin-top:24px;background:#b94e64}small{color:var(--muted)}@media(prefers-color-scheme:dark){:root{--bg:#111017;--surface:#1b1925;--ink:#e8e5f1;--muted:#a29bb5;--border:#302b40;--accent:#b99aef}}@media(max-width:600px){body{margin-top:20px;padding:0 14px 30px}h1{font-size:23px}td,th{padding:10px 7px;font-size:11px}details{padding:12px}form{padding:14px}}
</style>
